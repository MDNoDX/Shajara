# Nusxa oling:  cp .env.example .env  — keyin qiymatlarni oʻzgartiring.

# Sayt manzili (domen). DNS da A-yozuv server IP manziliga yoʻnaltirilgan boʻlishi kerak.
DOMAIN=shajara.example.uz
DJANGO_ALLOWED_HOSTS=shajara.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://shajara.example.uz

# Uzun tasodifiy qator. Yaratish:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0

# PostgreSQL paroli (docker-compose oʻzi DATABASE_URL ni tuzadi).
POSTGRES_PASSWORD=change-me-too

# Google orqali kirish (ixtiyoriy): console.cloud.google.com → OAuth client ID (Web).
# Redirect URI: https://DOMEN/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram eslatmalari (ixtiyoriy): @BotFather da bot yarating.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Parolni tiklash xatlari uchun pochta (ixtiyoriy). Boʻsh qolsa, xatlar faqat logga yoziladi.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Shajara <no-reply@example.uz>

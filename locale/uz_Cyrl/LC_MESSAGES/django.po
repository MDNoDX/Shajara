msgstr "Эслатмалар Telegramга ҳар куни соат %(hour)s:00 да келади. Ботда: /next — яқин саналар, /stop — ўчириш."

#: templates/notify/settings.html:20
msgid "Send a test message"
msgstr "Синов хабарини юбориш"

#: templates/notify/settings.html:22
msgid "Pause"
msgstr "Тўхтатиб туриш"

#: templates/notify/settings.html:22
msgid "Resume"
msgstr "Давом эттириш"

#: templates/notify/settings.html:30
msgid "Open the bot in the Telegram app"
msgstr "Ботни Telegram иловасида очинг"

#: templates/notify/settings.html:32
#, python-format
msgid "Open @%(bot)s"
msgstr "@%(bot)s ни очиш"

#: templates/notify/settings.html:33
msgid "Telegram Web"
msgstr "Telegram Web"

#: templates/notify/settings.html:37
msgid "Press “Start” — or send the bot this code:"
msgstr "«Start» тугмасини босинг — ёки ботга шу кодни юборинг:"

#: templates/notify/settings.html:40
msgid "Copy"
msgstr "Нусхалаш"

#: templates/notify/settings.html:42
msgid "The code works for one hour."
msgstr "Код бир соат амал қилади."

#: templates/notify/settings.html:45
msgid "Done: this page updates by itself."
msgstr "Тайёр: бу саҳифа ўзи янгиланади."

#: templates/notify/settings.html:46
msgid "Waiting for Telegram…"
msgstr "Telegram кутилмоқда…"

#: templates/notify/settings.html:51
msgid "On your phone: scan with the camera"
msgstr "Телефонда: камера билан сканерланг"

#: templates/notify/settings.html:55
msgid "Get a new code"
msgstr "Янги код олиш"

#: templates/notify/settings.html:65
msgid "Reminders are only for you. Turn on what you need."
msgstr "Эслатмалар фақат сизга келади. Кераклиларини ёқинг."

#: templates/notify/settings.html:68
msgid "What to remind me of"
msgstr "Нималар эслатилсин"

#: templates/notify/settings.html:72
msgid "When"
msgstr "Қачон"

#: templates/notify/settings.html:74
msgid "You are also reminded on the day itself."
msgstr "Ўша куннинг ўзида ҳам эслатилади."

#: templates/partials/google_button.html:4 templates/socialaccount/login.html:8
msgid "Continue with Google"
msgstr "Google орқали давом этиш"

#: templates/registration/password_reset_email.txt:1
#, python-format
msgid "Hello, %(name)s!"
msgstr "Ассалому алайкум, %(name)s!"

#: templates/registration/password_reset_email.txt:3
msgid "We received a request to set a new password for your family tree account. To choose a new password, open this link:"
msgstr "Шажара сайтидаги ҳисобингиз учун янги парол ўрнатиш сўрови келди. Янги парол танлаш учун қуйидаги ҳаволани очинг:"

#: templates/registration/password_reset_email.txt:7
#, python-format
msgid "Your username: %(username)s"
msgstr "Фойдаланувчи номингиз: %(username)s"

#: templates/registration/password_reset_email.txt:9
msgid "If you did not ask for this, you can ignore this email; your password will not change."
msgstr "Агар бу сўровни сиз юбормаган бўлсангиз, хатга эътибор берманг — паролингиз ўзгармайди."

#: templates/registration/password_reset_subject.txt:1
msgid "Setting a new password"
msgstr "Янги парол ўрнатиш"

#: templates/socialaccount/authentication_error.html:6 templates/socialaccount/signup.html:6
msgid "Could not sign in with Google"
msgstr "Google орқали кириб бўлмади"

#: templates/socialaccount/authentication_error.html:7 templates/socialaccount/signup.html:7
msgid "Something went wrong while signing in. Please try again."
msgstr "Кириш пайтида хатолик юз берди. Қайтадан уриниб кўринг."

#: templates/socialaccount/login_cancelled.html:6
msgid "Sign-in was cancelled"
msgstr "Кириш бекор қилинди"

#: templates/socialaccount/login_cancelled.html:7
msgid "You can try again or sign in with a username and password."
msgstr "Қайтадан уриниб кўринг ёки фойдаланувчи номи ва парол билан киринг."

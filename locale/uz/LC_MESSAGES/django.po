msgstr "Foydalanuvchi nomingiz: %(username)s"

#: templates/registration/password_reset_email.txt:9
msgid "If you did not ask for this, you can ignore this email; your password will not change."
msgstr "Agar bu soʻrovni siz yubormagan boʻlsangiz, xatga eʼtibor bermang — parolingiz oʻzgarmaydi."

#: templates/registration/password_reset_subject.txt:1
msgid "Setting a new password"
msgstr "Yangi parol oʻrnatish"

#: templates/socialaccount/authentication_error.html:6 templates/socialaccount/signup.html:6
msgid "Could not sign in with Google"
msgstr "Google orqali kirib boʻlmadi"

#: templates/socialaccount/authentication_error.html:7 templates/socialaccount/signup.html:7
msgid "Something went wrong while signing in. Please try again."
msgstr "Kirish paytida xatolik yuz berdi. Qaytadan urinib koʻring."

#: templates/socialaccount/login_cancelled.html:6
msgid "Sign-in was cancelled"
msgstr "Kirish bekor qilindi"

#: templates/socialaccount/login_cancelled.html:7
msgid "You can try again or sign in with a username and password."
msgstr "Qaytadan urinib koʻring yoki foydalanuvchi nomi va parol bilan kiring."
